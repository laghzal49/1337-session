#!/usr/bin/env bash
set -euo pipefail
REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
UV_BIN="${UV_BIN:-uv}"
if ! command -v "$UV_BIN" >/dev/null 2>&1; then
  printf 'uv is required; install it or run python3 nvim/scripts/update_docs.py\n' >&2
  exit 1
fi
exec "$UV_BIN" run --script "$REPO_DIR/nvim/scripts/update_docs.py" "$@"
