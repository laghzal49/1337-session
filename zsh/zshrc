# Created by newuser for 5.8.1
export PATH="$HOME/.local/bin:$PATH"
eval "$(starship init zsh)"
export UV_CACHE_DIR="$HOME/goinfre/.uv_cache"
export PATH=~/.npm-global/bin:$PATH
# --- Storage & Quota Tracking ---
alias quota="df -h ~"
alias movespace="du -sh * 2>/dev/null | sort -hr | head -n 10"

# --- Quick Git Shortcuts ---
alias gst="git status"
alias gaa="git add ."
alias gcm="git commit -m"
alias gp="git push"

# --- SSH Convenience ---
alias catssh="cat ~/.ssh/id_ed25519.pub"
alias testssh="ssh -T git@github.com"

# --- Process Killers (Useful when LLMs or scripts lock up)
alias nuke="pkill -f nvim || pkill -f python"

alias code='/goinfre/tlaghzal/VSCode-linux-x64/bin/code'

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
alias gcl="git clone"
export PATH="$HOME/.local/bin:$PATH"


# Added by Antigravity CLI installer
export PATH="/home/tlaghzal/.local/bin:$PATH"

alias cclean='bash ~/LinuxCleaner_42.sh'
export PATH="$HOME/bin:$PATH"

# --- Neofetch on terminal startup (Carbon-styled, config in ~/.config/neofetch) ---
# only in interactive shells, and skip nested shells / IDE terminals spawning fast
if [[ -o interactive ]] && (( ! ${+NVIM} )) && command -v neofetch >/dev/null; then
  neofetch
fi
